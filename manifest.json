{
  "manifest_version": 3,
  "name": "ClaudeMeter",
  "version": "0.8.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "icons": {
    "16": "src/icons/icon16.png",
    "32": "src/icons/icon32.png",
    "48": "src/icons/icon48.png",
    "128": "src/icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "src/icons/icon16.png",
      "32": "src/icons/icon32.png",
      "48": "src/icons/icon48.png",
      "128": "src/icons/icon128.png"
    }
  },
  "options_page": "src/options/options.html",
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+U" },
      "description": "__MSG_cmdOpen__"
    },
    "refresh-usage": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "__MSG_cmdRefresh__"
    },
    "toggle-snooze": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "__MSG_cmdSnooze__"
    },
    "toggle-privacy": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "__MSG_cmdPrivacy__"
    }
  },
  "omnibox": {
    "keyword": "cm"
  },
  "side_panel": {
    "default_path": "src/popup/popup.html?view=panel"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["src/content/inject-hook.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["src/content/relay.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": [
        "src/content/page-ui/core.js",
        "src/content/page-ui/styles.js",
        "src/content/page-ui/dock.js",
        "src/content/page-ui/banners.js",
        "src/content/page-ui/tab-indicator.js",
        "src/content/page-ui/nudges.js",
        "src/content/page-ui/main.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": ["storage", "unlimitedStorage", "alarms", "notifications", "sidePanel", "contextMenus", "offscreen", "nativeMessaging"],
  "host_permissions": ["https://claude.ai/*"],
  "optional_permissions": ["downloads"],
  "optional_host_permissions": [
    "https://hooks.slack.com/*",
    "https://discord.com/*",
    "https://discordapp.com/*",
    "https://ntfy.sh/*",
    "https://api.anthropic.com/*"
  ]
}
